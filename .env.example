# Public canonical origin, no trailing slash; use production domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gmail SMTP works without a custom domain. All mail credentials are server-only.
MAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional alternative: MAIL_PROVIDER=resend with a verified sending domain.
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Generate each secret separately: openssl rand -hex 32
RATE_LIMIT_SALT=
PRICE_IMPORT_SECRET=
CRON_SECRET=
# Exact approved HTTPS hostnames, comma-separated; no wildcards.
PRICE_SOURCE_HOSTS=
# Approved provider adapter returning the version-1 normalized feed; not an HTML page.
CATALOGUE_FEED_URL=
CATALOGUE_FEED_TOKEN=

# Public brochure storage origin (bucket URL, no credentials); production build only.
BROCHURE_ASSET_ORIGIN=
